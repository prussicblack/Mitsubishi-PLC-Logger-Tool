        <mxCell id="iMCwz9vOX7xCx346aN23-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="기본 데이터 구조.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Type Json.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &quot;Connection&quot;: {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &quot;PlcType&quot;: &quot;MitsubishiQ&quot;, &quot;Protocol&quot;: &quot;UDP&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &quot;IpAddress&quot;: &quot;192.168.1.10&quot;, &quot;Port&quot;: 5000,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &quot;Timeout&quot;: 3000, &quot;PollingIntervalMs&quot;: 100&lt;/div&gt;&lt;div&gt;&amp;nbsp; },&lt;/div&gt;&lt;div&gt;&amp;nbsp; &quot;Groups&quot;: [&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;ID&quot;: &quot;AnalogMonitor&quot;, &quot;DeviceCode&quot;: &quot;D&quot;, &quot;AddressNumberType&quot;: &quot;Decimal&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;Type&quot;: &quot;Word&quot;, &quot;StartAddress&quot;: &quot;1000&quot;, &quot;ReadSize&quot;: 100,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;Links&quot;: [&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; { &quot;Name&quot;: &quot;Temperature&quot;, &quot;Address&quot;: &quot;1000&quot;, &quot;Size&quot;: 1, &quot;BitIndex&quot;: null, &quot;BitSize&quot;: null, &quot;ValueType&quot;: &quot;INT&quot; },&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; { &quot;Name&quot;: &quot;Pressure&quot;, &quot;Address&quot;: &quot;1001&quot;, &quot;Size&quot;: 1, &quot;BitIndex&quot;: null, &quot;BitSize&quot;: null, &quot;ValueType&quot;: &quot;INT&quot; },&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; { &quot;Name&